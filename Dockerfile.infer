# syntax=docker/dockerfile:1
# A plain Python base is all we need: torch and its CUDA 12.8 libraries are installed from uv.lock by `uv sync`,
# so only the host driver matters. cu128 wheels cover Turing (sm_75) through Blackwell (sm_120) and run on host
# drivers >= R525 -- but they dropped Volta, so avoid V100/Pascal hosts.
#
# IMPORTANT: build with `--platform linux/amd64` for x86_64 deploy targets. The lockfile only resolves to
# CUDA-enabled torch on x86_64 linux -- an arm64 build (e.g. on an Apple Silicon Mac without --platform) silently
# gets CPU-only torch.
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1
ENV UV_LINK_MODE=copy
ENV UV_COMPILE_BYTECODE=1
ENV UV_PROJECT_ENVIRONMENT=/.venv

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl unzip && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /

COPY pyproject.toml uv.lock /
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --only-group infer

ENV PATH="/.venv/bin:$PATH"

# `spacy download` shells out to pip, which uv-created venvs don't include; install the model wheel directly
RUN uv pip install --python /.venv/bin/python \
    https://github.com/explosion/spacy-models/releases/download/en_core_web_md-3.8.0/en_core_web_md-3.8.0-py3-none-any.whl

# Pre-bake the Hugging Face base model so fresh containers don't re-download ~440MB from the Hub each run
# (apply_docbot.py reloads it from cache once per case). PEFT adapters + thresholds.json come from S3 at runtime.
ENV HF_HOME=/hf
RUN python -c "from transformers import AutoModelForSequenceClassification, AutoTokenizer; \
    AutoTokenizer.from_pretrained('bert-base-uncased'); \
    AutoModelForSequenceClassification.from_pretrained('bert-base-uncased', num_labels=2)"

COPY . /.

ENV PYTHONPATH=/

# Runtime env vars to set on the container: the tosdr-infer-bootstrap user's AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY plus AWS_ACCOUNT (apply_docbot.py assumes the tosdr-infer role from them) for S3 model pulls,
# and PHOENIX_API_URL / PHOENIX_API_KEY unless running with --local_data --dont_post.

# Using ENTRYPOINT allows us to pass args with `docker run`
# ENTRYPOINT ["python", "/src/apply_docbot.py"]

# For now we'll manually start inference, so just sleep here
CMD ["sleep", "infinity"]
